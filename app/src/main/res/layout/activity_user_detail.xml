<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="@drawable/login_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Détails de l'utilisateur"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#202B50"
                android:gravity="center"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mettre à jour les informations et le rôle"
                android:textSize="14sp"
                android:textColor="#555F78"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <EditText
                android:id="@+id/edtDetailName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#757575"
                android:hint="Full Name"
                android:inputType="textPersonName"
                android:background="@drawable/input_background" />

            <EditText
                android:id="@+id/edtDetailEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#757575"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:background="@drawable/input_background" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rôle"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#202B50"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <RadioGroup
                android:id="@+id/rgRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/input_background">

                <RadioButton
                    android:id="@+id/rbTravailleur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Travailleur"
                    android:textSize="14sp"
                    android:textColor="#FF000000"
                    android:buttonTint="#5265D8" />

                <RadioButton
                    android:id="@+id/rbAdminRh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Administrateur RH"
                    android:textSize="14sp"
                    android:textColor="#FF000000"
                    android:buttonTint="#5265D8" />

                <RadioButton
                    android:id="@+id/rbResponsableEquipe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Responsable d'équipe"
                    android:textSize="14sp"
                    android:textColor="#FF000000"
                    android:buttonTint="#5265D8" />

            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/btnUpdateUser"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="Modifier"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/login_button"
                    android:backgroundTint="@null"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/btnDeleteUser"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Supprimer"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/login_button"
                    android:backgroundTint="#C62828"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>