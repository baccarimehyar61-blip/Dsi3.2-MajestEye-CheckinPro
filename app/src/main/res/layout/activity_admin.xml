<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête : Titre et Déconnexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Administration"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#202B50" />

            <Button
                android:id="@+id/btnLogoutAdmin"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:paddingHorizontal="16dp"
                android:text="Déconnexion"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/login_button"
                android:backgroundTint="@null"
                android:textAllCaps="false" />

        </LinearLayout>

        <!-- Carte d'ajout d'utilisateur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/login_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajouter un utilisateur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#202B50"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/edtAdminName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#757575"
                android:hint="Nom complet"
                android:inputType="textPersonName"
                android:background="@drawable/input_background" />

            <EditText
                android:id="@+id/edtAdminEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#757575"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:background="@drawable/input_background" />

            <EditText
                android:id="@+id/edtAdminPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:padding="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:textColor="#FF000000"
                android:textColorHint="#757575"
                android:hint="Mot de passe"
                android:inputType="textPassword"
                android:background="@drawable/input_background" />

            <Button
                android:id="@+id/btnAddUser"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="AJOUTER"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/login_button"
                android:backgroundTint="@null" />

        </LinearLayout>

        <!-- Liste des utilisateurs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:orientation="vertical"
            android:background="@drawable/login_card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Utilisateurs enregistrés"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#202B50"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUsers"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>